<Application
    x:Class="SurveyController.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <GridLength x:Key="ShellTitleBarHeight">48</GridLength>
            <x:Double x:Key="DesktopBreakpointWidth">720</x:Double>
            <CornerRadius x:Key="WizardCardCornerRadius">10</CornerRadius>
            <x:Double x:Key="PageContentMaxWidth">900</x:Double>
            <x:Double x:Key="PageContentPadding">28</x:Double>
            <Thickness x:Key="PageCardPadding">20</Thickness>
            <Style x:Key="PageCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource WizardCardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource PageCardPadding}" />
            </Style>
            <Style x:Key="PageSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
            <Style x:Key="WizardBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource WizardBadgeForegroundBrush}" />
            </Style>
            <Style x:Key="WizardTextBadgeStyle" TargetType="ContentControl">
                <Setter Property="Background" Value="{ThemeResource WizardBadgeBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource WizardBadgeForegroundBrush}" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="QuestionChoiceBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="QuestionTextBrush" Color="#007C91" />
                    <SolidColorBrush x:Key="QuestionScaleBrush" Color="#107C10" />
                    <SolidColorBrush x:Key="QuestionMatrixBrush" Color="#C65D00" />
                    <SolidColorBrush x:Key="QuestionSortBrush" Color="#9A6700" />
                    <SolidColorBrush x:Key="QuestionUnknownBrush" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="QuestionChoiceBadgeForegroundBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="QuestionTextBadgeForegroundBrush" Color="#007C91" />
                    <SolidColorBrush x:Key="QuestionScaleBadgeForegroundBrush" Color="#107C10" />
                    <SolidColorBrush x:Key="QuestionMatrixBadgeForegroundBrush" Color="#C65D00" />
                    <SolidColorBrush x:Key="QuestionSortBadgeForegroundBrush" Color="#9A6700" />
                    <SolidColorBrush x:Key="QuestionUnknownBadgeForegroundBrush" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="WizardBadgeBackgroundBrush" Color="#0C005FB8" />
                    <SolidColorBrush x:Key="WizardBadgeForegroundBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="QuestionChoiceBadgeBackgroundBrush" Color="#0C005FB8" />
                    <SolidColorBrush x:Key="QuestionTextBadgeBackgroundBrush" Color="#0C007C91" />
                    <SolidColorBrush x:Key="QuestionScaleBadgeBackgroundBrush" Color="#0C107C10" />
                    <SolidColorBrush x:Key="QuestionMatrixBadgeBackgroundBrush" Color="#0CC65D00" />
                    <SolidColorBrush x:Key="QuestionSortBadgeBackgroundBrush" Color="#0C9A6700" />
                    <SolidColorBrush x:Key="QuestionUnknownBadgeBackgroundBrush" Color="#0C5D5D5D" />
                    <SolidColorBrush x:Key="RequiredBadgeBackgroundBrush" Color="#0C8A3FFC" />
                    <SolidColorBrush x:Key="RequiredBadgeForegroundBrush" Color="#8A3FFC" />
                    <SolidColorBrush x:Key="MediaBadgeBackgroundBrush" Color="#0C0F766E" />
                    <SolidColorBrush x:Key="MediaBadgeForegroundBrush" Color="#0F766E" />
                    <SolidColorBrush x:Key="ConditionalDisplayBadgeBackgroundBrush" Color="#0C166534" />
                    <SolidColorBrush x:Key="ConditionalDisplayBadgeForegroundBrush" Color="#166534" />
                    <SolidColorBrush x:Key="ControlsDisplayBadgeBackgroundBrush" Color="#0C0F766E" />
                    <SolidColorBrush x:Key="ControlsDisplayBadgeForegroundBrush" Color="#0F766E" />
                    <SolidColorBrush x:Key="JumpBadgeBackgroundBrush" Color="#0CB45309" />
                    <SolidColorBrush x:Key="JumpBadgeForegroundBrush" Color="#B45309" />
                    <SolidColorBrush x:Key="UnsupportedBadgeBackgroundBrush" Color="#0C5D5D5D" />
                    <SolidColorBrush x:Key="UnsupportedBadgeForegroundBrush" Color="#5D5D5D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="QuestionChoiceBrush" Color="#62B0FF" />
                    <SolidColorBrush x:Key="QuestionTextBrush" Color="#62D9E8" />
                    <SolidColorBrush x:Key="QuestionScaleBrush" Color="#6BCB6B" />
                    <SolidColorBrush x:Key="QuestionMatrixBrush" Color="#FFB36B" />
                    <SolidColorBrush x:Key="QuestionSortBrush" Color="#F2C66D" />
                    <SolidColorBrush x:Key="QuestionUnknownBrush" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="QuestionChoiceBadgeForegroundBrush" Color="#B8DEFF" />
                    <SolidColorBrush x:Key="QuestionTextBadgeForegroundBrush" Color="#B8F5FA" />
                    <SolidColorBrush x:Key="QuestionScaleBadgeForegroundBrush" Color="#B8F0B8" />
                    <SolidColorBrush x:Key="QuestionMatrixBadgeForegroundBrush" Color="#FFE0C2" />
                    <SolidColorBrush x:Key="QuestionSortBadgeForegroundBrush" Color="#FFE3A8" />
                    <SolidColorBrush x:Key="QuestionUnknownBadgeForegroundBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="WizardBadgeBackgroundBrush" Color="#1262B0FF" />
                    <SolidColorBrush x:Key="WizardBadgeForegroundBrush" Color="#B8DEFF" />
                    <SolidColorBrush x:Key="QuestionChoiceBadgeBackgroundBrush" Color="#1262B0FF" />
                    <SolidColorBrush x:Key="QuestionTextBadgeBackgroundBrush" Color="#1262D9E8" />
                    <SolidColorBrush x:Key="QuestionScaleBadgeBackgroundBrush" Color="#126BCB6B" />
                    <SolidColorBrush x:Key="QuestionMatrixBadgeBackgroundBrush" Color="#12FFB36B" />
                    <SolidColorBrush x:Key="QuestionSortBadgeBackgroundBrush" Color="#12F2C66D" />
                    <SolidColorBrush x:Key="QuestionUnknownBadgeBackgroundBrush" Color="#12C8C8C8" />
                    <SolidColorBrush x:Key="RequiredBadgeBackgroundBrush" Color="#12C7A8FF" />
                    <SolidColorBrush x:Key="RequiredBadgeForegroundBrush" Color="#C7A8FF" />
                    <SolidColorBrush x:Key="MediaBadgeBackgroundBrush" Color="#124FD1C5" />
                    <SolidColorBrush x:Key="MediaBadgeForegroundBrush" Color="#4FD1C5" />
                    <SolidColorBrush x:Key="ConditionalDisplayBadgeBackgroundBrush" Color="#124ADE80" />
                    <SolidColorBrush x:Key="ConditionalDisplayBadgeForegroundBrush" Color="#4ADE80" />
                    <SolidColorBrush x:Key="ControlsDisplayBadgeBackgroundBrush" Color="#1267E8F9" />
                    <SolidColorBrush x:Key="ControlsDisplayBadgeForegroundBrush" Color="#67E8F9" />
                    <SolidColorBrush x:Key="JumpBadgeBackgroundBrush" Color="#12FBBF24" />
                    <SolidColorBrush x:Key="JumpBadgeForegroundBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="UnsupportedBadgeBackgroundBrush" Color="#12C8C8C8" />
                    <SolidColorBrush x:Key="UnsupportedBadgeForegroundBrush" Color="#C8C8C8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="QuestionChoiceBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="QuestionTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="QuestionScaleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="QuestionMatrixBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="QuestionSortBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="QuestionUnknownBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="QuestionChoiceBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="QuestionTextBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="QuestionScaleBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="QuestionMatrixBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="QuestionSortBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="QuestionUnknownBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="WizardBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WizardBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="QuestionChoiceBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="QuestionTextBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="QuestionScaleBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="QuestionMatrixBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="QuestionSortBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="QuestionUnknownBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="RequiredBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="RequiredBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="MediaBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="MediaBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ConditionalDisplayBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ConditionalDisplayBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ControlsDisplayBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ControlsDisplayBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="JumpBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="JumpBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="UnsupportedBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="UnsupportedBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>`r`n
