<Window
    x:Class="SurveyController.App.AnswerEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App">
    <Grid Background="Transparent" KeyDown="OnKeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="配置向导">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/appicon.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Button Width="40" Height="40" Click="OnOpenAISettings" AutomationProperties.AutomationId="AnswerEditor.AISettings" AutomationProperties.Name="AI 服务设置" ToolTipService.ToolTip="AI 服务设置">
                    <SymbolIcon Symbol="Setting" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>
        <local:StrategyEditor x:Name="Editor" Grid.Row="1" Margin="24,0" />
        <Grid Grid.Row="2" Padding="24,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                <Button Content="上一题" Click="OnPreviousQuestion" AutomationProperties.AutomationId="AnswerEditor.PreviousQuestion" AutomationProperties.AcceleratorKey="Ctrl+PageUp" />
                <Button Content="下一题" Click="OnNextQuestion" AutomationProperties.AutomationId="AnswerEditor.NextQuestion" AutomationProperties.AcceleratorKey="Ctrl+PageDown" />
                <Button Content="取消" Click="OnCancel" AutomationProperties.AutomationId="AnswerEditor.Cancel" />
                <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Click="OnSave" AutomationProperties.AutomationId="AnswerEditor.SaveAll" AutomationProperties.AcceleratorKey="Ctrl+S">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Save" /><TextBlock Text="保存全部答案" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
