<Page
    x:Class="SurveyController.App.MorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactDonationLayout" />
                <VisualState x:Name="WideDonationLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource DesktopBreakpointWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DonationRightColumn.Width" Value="*" />
                        <Setter Target="DonationRightGroup.(Grid.Row)" Value="0" />
                        <Setter Target="DonationRightGroup.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer x:Name="MoreScrollViewer" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="{x:Bind MoreScrollViewer.ViewportWidth, Mode=OneWay}" Padding="24,24,24,32" HorizontalAlignment="Stretch" Spacing="16">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="8" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="更多" />

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="96" Height="96" VerticalAlignment="Top" Source="ms-appx:///Assets/appicon.png" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="SurveyController" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="高效的自动化问卷填写工具" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="当前版本 v5.0.0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Padding="16" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <SymbolIcon VerticalAlignment="Top" Symbol="Important" />
                    <TextBlock Grid.Column="1" Text="本项目仅供学习交流使用，禁止用于恶意滥用行为。" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="更新" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="当前版本" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="VersionText" FontWeight="SemiBold" Text="v5.0.0" />
                            <TextBlock x:Name="PublishDate" Style="{StaticResource CaptionTextBlockStyle}" Text="" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="UpdateStatus" AutomationProperties.LiveSetting="Polite" Style="{StaticResource CaptionTextBlockStyle}" Text="点击检查新版本" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReleaseNotes" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="UpdateButton" Content="检查更新" Click="OnCheckUpdate" />
                        <Button x:Name="DownloadButton" IsEnabled="False" Content="下载安装包" Click="OnOpenDownload" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="相关链接" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="GitHub 仓库" Click="OnOpenRepository" />
                        <Button Content="官方文档" Click="OnOpenTutorial" />
                        <Button Content="查看许可证" Click="OnOpenLicense" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="项目致谢" />
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="License：GPL-3.0 License" />
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="贡献者" />
                            <HyperlinkButton HorizontalAlignment="Left" Content="@HUNGRY_M0" Click="OnOpenContributor1" />
                            <HyperlinkButton HorizontalAlignment="Left" Content="@shiahonb777" Click="OnOpenContributor2" />
                            <HyperlinkButton HorizontalAlignment="Left" Content="@BingBuLiang" Click="OnOpenContributor3" />
                            <HyperlinkButton HorizontalAlignment="Left" Content="@dAwn-Rebirth" Click="OnOpenContributor4" />
                            <HyperlinkButton HorizontalAlignment="Left" Content="@Moyuin-aka" Click="OnOpenContributor5" />
                            <HyperlinkButton HorizontalAlignment="Left" Content="@qintaiyang" Click="OnOpenContributor6" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="服务条款与隐私声明" />
                            <Button Content="查看详情" Click="OnOpenTerms" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Text="更多入口" />
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="打开更多功能">
                <StackPanel Padding="0,8,0,4" Spacing="8">
                    <Button HorizontalContentAlignment="Left" Content="更新日志" Click="OnOpenChangelog" />
                    <Button HorizontalContentAlignment="Left" Content="使用教程" Click="OnOpenTutorial" />
                    <Button HorizontalContentAlignment="Left" Content="IP 使用记录" Click="OnLoadIPUsage" />
                    <Button HorizontalContentAlignment="Left" Content="捐助" Click="OnOpenDonation" />
                </StackPanel>
            </Expander>

            <Expander x:Name="DonationExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="支持作者">
                <StackPanel Padding="0,12,0,4" Spacing="16">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="如果这个项目对你有帮助，欢迎请作者喝杯奶茶。" TextWrapping="Wrap" />
                    <Grid x:Name="DonationLayout" ColumnSpacing="16" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DonationLeftColumn" Width="*" />
                            <ColumnDefinition x:Name="DonationRightColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="DonationLeftGroup" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="微信赞赏" />
                            <Image Width="220" Height="220" HorizontalAlignment="Left" Source="ms-appx:///Assets/WeDonate.png" Stretch="Uniform" />
                        </StackPanel>
                        <StackPanel x:Name="DonationRightGroup" Grid.Row="1" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="支付宝" />
                            <Image Width="220" Height="220" HorizontalAlignment="Left" Source="ms-appx:///Assets/AliDonate.jpg" Stretch="Uniform" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="感谢每一位支持者，你们的鼓励是持续更新的动力。" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <Expander x:Name="IPUsageExpander" Header="IP 使用记录">
                <StackPanel Padding="0,12,0,4" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="刷新记录" Click="OnLoadIPUsage" />
                        <TextBlock x:Name="IPBalance" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="IP 池剩余数量：未加载" />
                    </StackPanel>
                    <TextBlock x:Name="IPUsageStatus" AutomationProperties.LiveSetting="Polite" Style="{StaticResource CaptionTextBlockStyle}" Text="" TextWrapping="Wrap" />
                    <ListView ItemsSource="{x:Bind UsageItems, Mode=OneWay}" MaxHeight="360" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:IPUsageRow">
                                <Grid ColumnSpacing="12" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" />
                                    <ProgressBar Grid.Column="1" VerticalAlignment="Center" Maximum="{x:Bind Maximum}" Value="{x:Bind Total}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind CountText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Expander>

            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}" Text="Copyright © 2026 HUNGRY_M0. All rights reserved." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
