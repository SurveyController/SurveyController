<Page
    x:Class="SurveyController.App.TaskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="MinHeight" Value="72" />
        </Style>

        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="1,24,0,4" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="WizardShell" Grid.Row="0">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="CompactWizardForms">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ImportActionColumn.Width" Value="0" />
                            <Setter Target="ImportActionRow.Height" Value="Auto" />
                            <Setter Target="SurveyPrimaryButton.(Grid.Row)" Value="1" />
                            <Setter Target="SurveyPrimaryButton.(Grid.Column)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideWizardForms">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ImportActionColumn.Width" Value="Auto" />
                            <Setter Target="ImportActionRow.Height" Value="0" />
                            <Setter Target="SurveyPrimaryButton.(Grid.Row)" Value="0" />
                            <Setter Target="SurveyPrimaryButton.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid>
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                    <RowDefinition x:Name="FooterRow" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部向导进度与步骤标题 -->
                <Grid Margin="28,0">
                    <StackPanel Margin="0,16,0,12" Spacing="8">
                        <ProgressBar x:Name="StepProgress" Minimum="0" Maximum="5" Value="0" />
                        <TextBlock x:Name="StepSummary" Style="{StaticResource SubtitleTextBlockStyle}" Text="第 1/6 步：导入问卷" />
                    </StackPanel>
                </Grid>
                <Rectangle Grid.Row="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- 主工作区：6 个向导步骤 + 1 个任务运行面板 -->
                <Grid Grid.Row="2">
                    <!-- 第 1 步：导入问卷 -->
                    <ScrollViewer x:Name="SurveyPanel" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="{x:Bind SurveyPanel.ViewportWidth, Mode=OneWay}" Padding="28,32,28,40" HorizontalAlignment="Stretch" Spacing="16">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ImportActionColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="ImportActionRow" Height="0" /></Grid.RowDefinitions>
                                <TextBox x:Name="SurveyUrl" Header="问卷地址" AutomationProperties.Name="问卷链接" PlaceholderText="粘贴问卷链接" TextChanged="OnSurveyUrlChanged" />
                                <Button x:Name="SurveyPrimaryButton" Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Click="OnPrimary" AutomationProperties.Name="解析问卷并继续">
                                    <Button.ContentTransitions>
                                        <TransitionCollection>
                                            <ContentThemeTransition />
                                        </TransitionCollection>
                                    </Button.ContentTransitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon x:Name="SurveyPrimaryIcon" Symbol="Accept" /><TextBlock x:Name="SurveyPrimaryLabel" Text="解析并继续" /></StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnChooseQRCode" AutomationProperties.Name="识别二维码图片"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Scan" /><TextBlock Text="识别二维码" /></StackPanel></Button>
                                <Button Click="OnImportConfig" AutomationProperties.Name="导入配置文件"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="OpenLocal" /><TextBlock Text="导入配置" /></StackPanel></Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 第 2 步：自定义答案 -->
                    <ScrollViewer x:Name="AnswersPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="{x:Bind AnswersPanel.ViewportWidth, Mode=OneWay}" Padding="28,24,28,32" HorizontalAlignment="Stretch" Spacing="4">
                            <TextBlock Margin="0,0,0,16" FontSize="28" FontWeight="SemiBold" Text="答案策略" />

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="ViewAll" />
                                <Grid Grid.Column="1" ColumnSpacing="24" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="总题数" />
                                        <TextBlock x:Name="AnswerTotalCount" FontSize="24" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="已配置" />
                                        <TextBlock x:Name="AnswerConfiguredCount" FontSize="24" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="AI 题" />
                                        <TextBlock x:Name="AnswerAICount" FontSize="24" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="异常" />
                                        <TextBlock x:Name="AnswerProblemCount" FontSize="24" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Edit" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="逐题答案编辑" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="为每道题配置答案策略、选项比例和填空内容" />
                                </StackPanel>
                                <Button x:Name="EditAnswersButton" Grid.Column="2" MinWidth="96" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Content="编辑答案" Click="OnEditAnswers" AutomationProperties.AutomationId="Task.EditAnswers" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 第 3 步：条件规则 -->
                    <ScrollViewer x:Name="RulesPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="{x:Bind RulesPanel.ViewportWidth, Mode=OneWay}" Padding="32,24" HorizontalAlignment="Stretch" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xF0AD;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="条件规则" /></StackPanel>
                            <local:RuleEditor x:Name="RuleEditorView" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 第 4 步：随机 IP / UA / 指定信度 -->
                    <ScrollViewer x:Name="NetworkPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="{x:Bind NetworkPanel.ViewportWidth, Mode=OneWay}" Padding="28,24,28,32" HorizontalAlignment="Stretch" Spacing="4">
                            <TextBlock Margin="0,0,0,16" FontSize="28" FontWeight="SemiBold" Text="网络与信度" />

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="代理状态" />
                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="World" />
                                <Grid Grid.Column="1" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="代理来源" />
                                        <TextBlock x:Name="ProxyStatusSource" FontWeight="SemiBold" Text="直连" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="可用额度" />
                                        <TextBlock x:Name="ProxyStatusQuota" FontWeight="SemiBold" Text="不适用" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="IP 池状态" />
                                        <TextBlock x:Name="ProxyStatusPool" FontWeight="SemiBold" Text="不适用" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="访问配置" />
                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE72E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="访问方式" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="选择问卷访问时使用的网络路径" />
                                </StackPanel>
                                <ComboBox x:Name="ProxyMode" Grid.Column="2" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="访问方式" SelectedIndex="0" SelectionChanged="OnProxyModeChanged">
                                    <ComboBoxItem Content="直连" Tag="direct" />
                                    <ComboBoxItem Content="固定代理" Tag="fixed" />
                                    <ComboBoxItem Content="随机 IP" Tag="random" />
                                </ComboBox>
                            </Grid>

                            <Grid x:Name="ProxySourceRow" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Link" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="代理来源" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="选择随机 IP 的提供源" />
                                </StackPanel>
                                <ComboBox x:Name="ProxySource" Grid.Column="2" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="代理来源" SelectedIndex="0" SelectionChanged="OnProxySourceChanged">
                                    <ComboBoxItem Content="默认代理" Tag="default" />
                                    <ComboBoxItem Content="限时福利" Tag="benefit" />
                                    <ComboBoxItem Content="自定义代理" Tag="custom" />
                                </ComboBox>
                            </Grid>

                            <Grid x:Name="FixedProxyRow" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Link" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock FontSize="16" Text="固定代理地址" />
                                    <TextBox x:Name="FixedProxyAddress" AutomationProperties.Name="固定代理地址" PlaceholderText="http://127.0.0.1:8080" />
                                </StackPanel>
                                <Button Grid.Column="2" MinWidth="96" HorizontalAlignment="Right" VerticalAlignment="Center" Content="测试连接" Click="OnTestFixedProxy" AutomationProperties.Name="测试固定代理连接" />
                            </Grid>

                            <Grid x:Name="CustomProxyRow" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Link" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock FontSize="16" Text="代理 API 地址" />
                                    <TextBox x:Name="CustomProxyApi" AutomationProperties.Name="代理 API" PlaceholderText="https://..." />
                                </StackPanel>
                                <Button Grid.Column="2" MinWidth="96" HorizontalAlignment="Right" VerticalAlignment="Center" Content="测试连接" Click="OnTestCustomProxy" AutomationProperties.Name="测试自定义代理连接" />
                            </Grid>

                            <Grid x:Name="ProxyAreaRow" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="MapPin" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock FontSize="16" Text="代理地域限制" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ProxyProvince" HorizontalAlignment="Stretch" AutomationProperties.Name="代理省份" PlaceholderText="不限制" SelectionChanged="OnProxyProvinceChanged" />
                                        <ComboBox x:Name="ProxyCity" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="代理城市" PlaceholderText="不限制" SelectionChanged="OnProxyCityChanged" />
                                    </Grid>
                                </StackPanel>
                                <Button x:Name="SyncProxyButton" Grid.Column="2" MinWidth="96" HorizontalAlignment="Right" VerticalAlignment="Center" Content="同步额度" Click="OnSyncProxy" AutomationProperties.Name="同步代理额度" />
                            </Grid>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="高级选项" />
                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="ContactInfo" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="随机 User-Agent 身份" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="每次访问时随机生成浏览器标识" />
                                </StackPanel>
                                <ToggleSwitch x:Name="RandomUA" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="随机访问身份" OffContent="关" OnContent="开" />
                            </Grid>

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE8BC;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="量表信度拟真 (Cronbach's α)" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="启用心理学信度控制，提高量表数据质量" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PsychometricsEnabled" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="启用心理学信度拟真" OffContent="关" OnContent="开" Toggled="OnPsychometricsToggled" />
                            </Grid>

                            <Grid x:Name="PsychometricsRow" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Target" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="目标信度系数" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="推荐范围 0.75 ~ 0.90" />
                                </StackPanel>
                                <NumberBox x:Name="TargetAlpha" Grid.Column="2" Width="140" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="目标信度系数" Minimum="0.5" Maximum="0.99" SmallChange="0.01" LargeChange="0.05" SpinButtonPlacementMode="Compact" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 第 5 步：作答时长 / 间隔时长 / 作答时间 -->
                    <ScrollViewer x:Name="TimingPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="{x:Bind TimingPanel.ViewportWidth, Mode=OneWay}" Padding="28,24,28,32" HorizontalAlignment="Stretch" Spacing="4">
                            <TextBlock Margin="0,0,0,16" FontSize="28" FontWeight="SemiBold" Text="时间与节奏" />

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="作答时长" />
                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Clock" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock FontSize="16" Text="单份作答时长（秒）" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="AnswerDurationMin" Header="最短" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="AnswerDurationMax" Grid.Column="1" Header="最长" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="RepeatAll" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock FontSize="16" Text="提交间隔冷却（秒）" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="SubmitIntervalMin" Header="最短" Minimum="0" Maximum="1800" SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="SubmitIntervalMax" Grid.Column="1" Header="最长" Minimum="0" Maximum="1800" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="有效作答时间窗口" />
                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Calendar" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock FontSize="16" Text="开始时间" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CalendarDatePicker x:Name="WindowStartDate" HorizontalAlignment="Stretch" />
                                        <TimePicker x:Name="WindowStartTime" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Calendar" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock FontSize="16" Text="结束时间" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CalendarDatePicker x:Name="WindowEndDate" HorizontalAlignment="Stretch" />
                                        <TimePicker x:Name="WindowEndTime" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="异常处理" />
                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Important" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="连续失败时自动停止" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="多次提交失败后停止任务,避免无效消耗" />
                                </StackPanel>
                                <ToggleSwitch x:Name="FailStop" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="连续失败时停止" OffContent="关" OnContent="开" />
                            </Grid>

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Pause" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="遇到验证码时自动暂停" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="检测到验证码挑战时暂停运行" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PauseCaptcha" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="遇到验证码时暂停" OffContent="关" OnContent="开" />
                            </Grid>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Excel 反填" />
                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Page" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="按表格内容覆盖答案" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="从 Excel 文件读取答案数据并替换对应题目" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ReverseFillButton" Click="OnChooseReverseFill" AutomationProperties.Name="选择 Excel 反填文件">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Page" />
                                            <TextBlock x:Name="ReverseFillButtonLabel" Text="选择 Excel" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleSwitch x:Name="ReverseFillEnabled" MinWidth="0" AutomationProperties.Name="启用 Excel 反填" OffContent="关" OnContent="开" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 第 6 步：目标份数 / 并发数 / 开始作答 -->
                    <ScrollViewer x:Name="LaunchPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="{x:Bind LaunchPanel.ViewportWidth, Mode=OneWay}" Padding="28,24,28,32" HorizontalAlignment="Stretch" Spacing="4">
                            <TextBlock Margin="0,0,0,16" FontSize="28" FontWeight="SemiBold" Text="规模与启动" />

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="运行参数" />
                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="AllApps" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock FontSize="16" Text="任务规模" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="TargetCount" Header="目标提交份数" AutomationProperties.Name="目标份数" Minimum="1" Maximum="999999" SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="ThreadCount" Header="并发线程数" AutomationProperties.Name="并发数" Minimum="1" Maximum="128" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="配置摘要" />
                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Document" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="问卷标题" />
                                    <TextBlock x:Name="ReviewSurvey" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE8FD;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="平台与题目" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                                    <TextBlock x:Name="ReviewProvider" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReviewQuestions" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Play" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="规模与并发" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                                    <TextBlock x:Name="ReviewTarget" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReviewThreads" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="World" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="网络与信度" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                                    <TextBlock x:Name="ReviewNetwork" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReviewReliability" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Clock" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="作答时长" />
                                </StackPanel>
                                <TextBlock x:Name="ReviewDuration" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>

                            <Grid Style="{StaticResource SettingsCardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon VerticalAlignment="Center" Symbol="Link" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="16" Text="问卷地址" />
                                    <TextBlock x:Name="ReviewUrl" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <ListView x:Name="CheckProblems" SelectionMode="None" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 运行态：任务运行与实时监控 -->
                    <ScrollViewer x:Name="RunPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="{x:Bind RunPanel.ViewportWidth, Mode=OneWay}" Padding="32,24" HorizontalAlignment="Stretch" Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Play" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="任务运行" /></StackPanel>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="1" Value="0" Height="8" VerticalAlignment="Center" CornerRadius="4" />
                                <TextBlock x:Name="RunProgressText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="0 / 0" />
                            </Grid>

                            <Border x:Name="RunResultCard" Visibility="Collapsed" Padding="16,12" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="成功份数" />
                                        <TextBlock x:Name="RunResultSuccess" FontSize="20" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="失败份数" />
                                        <TextBlock x:Name="RunResultFail" FontSize="20" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="提交合计" />
                                        <TextBlock x:Name="RunResultTotal" FontSize="20" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PauseButton" Content="暂停任务" IsEnabled="False" Click="OnPauseRun" />
                                <Button x:Name="ResumeButton" Content="继续任务" IsEnabled="False" Click="OnResumeRun" />
                                <Button x:Name="StopButton" Content="停止任务" IsEnabled="False" Click="OnStopRun" />
                                <Button x:Name="ExportResultButton" Visibility="Collapsed" Content="导出作答结果" Click="OnExportResult" />
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="260" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="实时日志" />
                                    <Button x:Name="ExportLogsButton" Visibility="Collapsed" HorizontalAlignment="Right" Content="导出日志" Click="OnExportLogs" />
                                </Grid>
                                <ListView x:Name="RunLogs" Grid.Row="1" Margin="0,8,0,0" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 底栏：返回、下一步 / 启动按钮 -->
                <Rectangle x:Name="FooterDivider" Grid.Row="3" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid x:Name="FooterBar" Grid.Row="4" Padding="32,0">
                    <TextBlock x:Name="FooterStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BackButton" Click="OnBack" AutomationProperties.Name="返回上一步"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Previous" /><TextBlock Text="返回上一步" /></StackPanel></Button>
                        <Button x:Name="PrimaryButton" Style="{StaticResource AccentButtonStyle}" Click="OnPrimary" AutomationProperties.Name="继续">
                            <Button.ContentTransitions>
                                <TransitionCollection>
                                    <ContentThemeTransition />
                                </TransitionCollection>
                            </Button.ContentTransitions>
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon x:Name="PrimaryButtonIcon" Symbol="Next" /><TextBlock x:Name="PrimaryButtonLabel" Text="继续" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 浮动通知与状态展示 InfoBar -->
            <StackPanel x:Name="StatusPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Spacing="8" IsHitTestVisible="True">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="-12" />
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <InfoBar x:Name="SurveyStatus" IsOpen="False" IsClosable="False" MaxWidth="720" />
                <InfoBar x:Name="NetworkStatus" IsOpen="False" IsClosable="False" MaxWidth="720" Severity="Informational" Title="直连" Message="不使用代理访问问卷。" />
                <InfoBar x:Name="CheckStatus" IsOpen="False" IsClosable="False" MaxWidth="720" Severity="Informational" Title="尚未检查配置" Message="点击底部按钮检查整套配置并启动作答。" />
                <InfoBar x:Name="RunStatus" IsOpen="False" IsClosable="False" MaxWidth="720" Severity="Informational" Title="尚未启动" Message="配置保存后可以启动任务。" />
                <InfoBar x:Name="RunExportStatus" IsOpen="False" IsClosable="False" MaxWidth="720" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
