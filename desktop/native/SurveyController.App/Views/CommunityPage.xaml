<Page
    x:Class="SurveyController.App.CommunityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >

    <ScrollViewer x:Name="CommunityScrollViewer" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="{x:Bind CommunityScrollViewer.ViewportWidth, Mode=OneWay}" Padding="28,28,28,40" HorizontalAlignment="Stretch" Spacing="20">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="8" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock FontSize="32" FontWeight="SemiBold" Text="社区与帮助" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="获取帮助、反馈问题并参与项目建设" />

            <TextBlock Style="{StaticResource PageSectionTitleStyle}" Text="获取帮助" />
            <Border Style="{StaticResource PageCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Grid.Column="0" VerticalAlignment="Top" Symbol="Message" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="QQ 群交流" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="扫码加入 QQ 交流群，获取最新版本、反馈问题、交流使用经验和订阅服务状态。" TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Left" Content="打开二维码" Click="OnOpenQr" />
                    </StackPanel>
                    <Image x:Name="CommunityQrImage" Grid.Column="2" Width="144" Height="144" HorizontalAlignment="Right" VerticalAlignment="Center" Source="ms-appx:///Assets/community_qr.png" Stretch="Uniform" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource PageSectionTitleStyle}" Text="参与项目" />
            <Border Style="{StaticResource PageCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon VerticalAlignment="Top" Symbol="Edit" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="参与贡献" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="开发、设计、测试、反馈和想法都能帮助项目继续完善。" TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Left" Content="仓库主页" Click="OnOpenRepository" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource PageSectionTitleStyle}" Text="许可与使用" />
            <Border Style="{StaticResource PageCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon VerticalAlignment="Top" Symbol="Document" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="开源许可" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="GPL-3.0" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="分发程序或修改版本时，必须按 GPL-3.0 提供相应源代码。" TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Left" Content="查看协议" Click="OnOpenLicense" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="欢迎加入社区，一起让这个项目变得更好" />
        </StackPanel>
    </ScrollViewer>
</Page>
