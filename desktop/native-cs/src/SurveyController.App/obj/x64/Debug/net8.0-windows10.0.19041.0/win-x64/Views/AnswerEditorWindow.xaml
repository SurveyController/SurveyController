<Window
    x:Class="SurveyController.App.Views.AnswerEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App.Views">
    <Grid x:ConnectionId='2' Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"                    >
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Padding="24,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="逐题答案编辑器" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="保存后一次提交全部题目答案；取消会恢复打开窗口前的配置。" />
            </StackPanel>
            <Button x:ConnectionId='6' Grid.Column="1" Width="40" Height="40"                          AutomationProperties.Name="AI 服务设置" AutomationProperties.AutomationId="AnswerEditorAiSettingsButton" ToolTipService.ToolTip="AI 服务设置">
                <SymbolIcon Symbol="Setting" />
            </Button>
        </Grid>
        <local:StrategyEditor x:ConnectionId='3' x:Name="Editor" Grid.Row="1" Margin="24,0" />
        <Grid Grid.Row="2" Padding="24,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                <Button x:ConnectionId='4' Content="取消"                  AutomationProperties.AutomationId="AnswerEditorCancelButton" />
                <Button x:ConnectionId='5' Style="{StaticResource AccentButtonStyle}"                AutomationProperties.AutomationId="AnswerEditorSaveButton">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Save" /><TextBlock Text="保存全部答案" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

