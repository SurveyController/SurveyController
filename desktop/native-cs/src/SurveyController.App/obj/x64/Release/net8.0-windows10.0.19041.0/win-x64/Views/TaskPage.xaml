<Page x:ConnectionId='1'
    x:Class="SurveyController.App.Views.TaskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App.Views"
                     
                         
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:ConnectionId='2' x:Name="WizardShell" Grid.Row="0">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:ConnectionId='3' x:Name="CompactWizardForms">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ImportActionColumn.Width" Value="0" />
                            <Setter Target="ImportActionRow.Height" Value="Auto" />
                            <Setter Target="SurveyPrimaryButton.(Grid.Row)" Value="1" />
                            <Setter Target="SurveyPrimaryButton.(Grid.Column)" Value="0" />
                            <Setter Target="AnswerStatsThirdColumn.Width" Value="0" />
                            <Setter Target="AnswerStatsFourthColumn.Width" Value="0" />
                            <Setter Target="AnswerStatsSecondRow.Height" Value="Auto" />
                            <Setter Target="AnswerAIPanel.(Grid.Row)" Value="1" />
                            <Setter Target="AnswerAIPanel.(Grid.Column)" Value="0" />
                            <Setter Target="AnswerProblemPanel.(Grid.Row)" Value="1" />
                            <Setter Target="AnswerProblemPanel.(Grid.Column)" Value="1" />
                            <Setter Target="TimingSecondColumn.Width" Value="0" />
                            <Setter Target="TimingSecondRow.Height" Value="Auto" />
                            <Setter Target="SubmitIntervalPanel.(Grid.Row)" Value="1" />
                            <Setter Target="SubmitIntervalPanel.(Grid.Column)" Value="0" />
                            <Setter Target="WindowSecondColumn.Width" Value="0" />
                            <Setter Target="WindowSecondRow.Height" Value="Auto" />
                            <Setter Target="WindowEndPanel.(Grid.Row)" Value="1" />
                            <Setter Target="WindowEndPanel.(Grid.Column)" Value="0" />
                            <Setter Target="LaunchSecondColumn.Width" Value="0" />
                            <Setter Target="LaunchSecondRow.Height" Value="Auto" />
                            <Setter Target="ThreadCount.(Grid.Row)" Value="1" />
                            <Setter Target="ThreadCount.(Grid.Column)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:ConnectionId='4' x:Name="WideWizardForms">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ImportActionColumn.Width" Value="Auto" />
                            <Setter Target="ImportActionRow.Height" Value="0" />
                            <Setter Target="SurveyPrimaryButton.(Grid.Row)" Value="0" />
                            <Setter Target="SurveyPrimaryButton.(Grid.Column)" Value="1" />
                            <Setter Target="AnswerStatsThirdColumn.Width" Value="*" />
                            <Setter Target="AnswerStatsFourthColumn.Width" Value="*" />
                            <Setter Target="AnswerStatsSecondRow.Height" Value="0" />
                            <Setter Target="AnswerAIPanel.(Grid.Row)" Value="0" />
                            <Setter Target="AnswerAIPanel.(Grid.Column)" Value="2" />
                            <Setter Target="AnswerProblemPanel.(Grid.Row)" Value="0" />
                            <Setter Target="AnswerProblemPanel.(Grid.Column)" Value="3" />
                            <Setter Target="TimingSecondColumn.Width" Value="*" />
                            <Setter Target="TimingSecondRow.Height" Value="0" />
                            <Setter Target="SubmitIntervalPanel.(Grid.Row)" Value="0" />
                            <Setter Target="SubmitIntervalPanel.(Grid.Column)" Value="1" />
                            <Setter Target="WindowSecondColumn.Width" Value="*" />
                            <Setter Target="WindowSecondRow.Height" Value="0" />
                            <Setter Target="WindowEndPanel.(Grid.Row)" Value="0" />
                            <Setter Target="WindowEndPanel.(Grid.Column)" Value="1" />
                            <Setter Target="LaunchSecondColumn.Width" Value="*" />
                            <Setter Target="LaunchSecondRow.Height" Value="0" />
                            <Setter Target="ThreadCount.(Grid.Row)" Value="0" />
                            <Setter Target="ThreadCount.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid>
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                    <RowDefinition x:ConnectionId='11' x:Name="FooterRow" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部向导进度与步骤标题 -->
                <Grid Margin="32,0">
                    <StackPanel Margin="0,12,0,10" Spacing="8">
                        <ProgressBar x:ConnectionId='117' x:Name="StepProgress" Minimum="0" Maximum="5" Value="0" AutomationProperties.AutomationId="TaskStepProgress" />
                        <TextBlock x:ConnectionId='118' x:Name="StepSummary" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="TaskStepSummary" Text="第 1/6 步：导入问卷" />
                    </StackPanel>
                </Grid>
                <Rectangle Grid.Row="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- 主工作区：6 个向导步骤 + 1 个任务运行面板 -->
                <Grid Grid.Row="2">
                    <!-- 第 1 步：导入问卷 -->
                    <ScrollViewer x:ConnectionId='19' x:Name="SurveyPanel" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:ConnectionId='108'                                                         MaxWidth="720" Padding="32,24" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Document" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="导入问卷" /></StackPanel>

                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:ConnectionId='111' x:Name="ImportActionColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:ConnectionId='112' x:Name="ImportActionRow" Height="0" /></Grid.RowDefinitions>
                                <TextBox x:ConnectionId='113' x:Name="SurveyUrl" Header="问卷地址" AutomationProperties.Name="问卷链接" AutomationProperties.AutomationId="TaskSurveyUrlInput" PlaceholderText="粘贴 HTTP / HTTPS 问卷链接"                                  />
                                <Button x:ConnectionId='114' x:Name="SurveyPrimaryButton" Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"                   AutomationProperties.Name="解析问卷并继续" AutomationProperties.AutomationId="TaskSurveyPrimaryButton">
                                    <Button.ContentTransitions>
                                        <TransitionCollection>
                                            <ContentThemeTransition />
                                        </TransitionCollection>
                                    </Button.ContentTransitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon x:ConnectionId='115' x:Name="SurveyPrimaryIcon" Symbol="Refresh" /><TextBlock x:ConnectionId='116' x:Name="SurveyPrimaryLabel" Text="解析并继续" /></StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button x:ConnectionId='109'                        AutomationProperties.Name="识别二维码图片" AutomationProperties.AutomationId="TaskChooseQrButton"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="View" /><TextBlock Text="识别二维码图片" /></StackPanel></Button>
                                <Button x:ConnectionId='110'                        AutomationProperties.Name="导入配置文件" AutomationProperties.AutomationId="TaskImportConfigButton"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Document" /><TextBlock Text="导入配置文件 (.json)" /></StackPanel></Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 第 2 步：自定义答案 -->
                    <ScrollViewer x:ConnectionId='20' x:Name="AnswersPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:ConnectionId='97'                                                          MaxWidth="720" Padding="32,24" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Edit" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="答案策略" /></StackPanel>
                            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource WizardCardCornerRadius}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:ConnectionId='99' x:Name="AnswerStatsThirdColumn" Width="*" />
                                            <ColumnDefinition x:ConnectionId='100' x:Name="AnswerStatsFourthColumn" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:ConnectionId='101' x:Name="AnswerStatsSecondRow" Height="0" /></Grid.RowDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="总题数" />
                                            <TextBlock x:ConnectionId='107' x:Name="AnswerTotalCount" FontSize="24" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskAnswerTotalText" Text="0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已配置" />
                                            <TextBlock x:ConnectionId='106' x:Name="AnswerConfiguredCount" FontSize="24" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskAnswerConfiguredText" Text="0" />
                                        </StackPanel>
                                        <StackPanel x:ConnectionId='102' x:Name="AnswerAIPanel" Grid.Column="2" Spacing="2">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="AI 题" />
                                            <TextBlock x:ConnectionId='105' x:Name="AnswerAICount" FontSize="24" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskAnswerAiText" Text="0" />
                                        </StackPanel>
                                        <StackPanel x:ConnectionId='103' x:Name="AnswerProblemPanel" Grid.Column="3" Spacing="2">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="异常" />
                                            <TextBlock x:ConnectionId='104' x:Name="AnswerProblemCount" FontSize="24" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskAnswerProblemText" Text="0" />
                                        </StackPanel>
                                    </Grid>
                                    <Button x:ConnectionId='98' x:Name="EditAnswersButton" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"                       AutomationProperties.Name="编辑逐题答案" AutomationProperties.AutomationId="TaskEditAnswersButton">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Edit" /><TextBlock Text="编辑逐题答案" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 第 3 步：条件规则 -->
                    <ScrollViewer x:ConnectionId='21' x:Name="RulesPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:ConnectionId='95'                                                        Padding="32,24" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Important" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="条件规则" /></StackPanel>
                            <local:RuleEditor x:ConnectionId='96' x:Name="RuleEditorView" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 第 4 步：随机 IP / UA / 指定信度 -->
                    <ScrollViewer x:ConnectionId='22' x:Name="NetworkPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:ConnectionId='74'                                                          MaxWidth="720" Padding="32,24" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Sync" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="网络与信度" /></StackPanel>

                            <!-- 代理状态摘要 -->
                            <Grid Padding="12,8" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="代理来源" />
                                    <TextBlock x:ConnectionId='94' x:Name="ProxyStatusSource" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskProxyStatusSourceText" Text="直连" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="可用额度" />
                                    <TextBlock x:ConnectionId='93' x:Name="ProxyStatusQuota" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskProxyStatusQuotaText" Text="不适用" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="IP 池状态" />
                                    <TextBlock x:ConnectionId='92' x:Name="ProxyStatusPool" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskProxyStatusPoolText" Text="不适用" />
                                </StackPanel>
                            </Grid>

                            <!-- 访问方式与代理配置 -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:ConnectionId='89' x:Name="ProxyMode" Header="访问方式" HorizontalAlignment="Stretch" AutomationProperties.Name="访问方式" AutomationProperties.AutomationId="TaskProxyModeComboBox" SelectedIndex="0"                                      >
                                    <ComboBoxItem Content="直连" Tag="direct" />
                                    <ComboBoxItem Content="固定代理" Tag="fixed" />
                                    <ComboBoxItem Content="随机 IP" Tag="random" />
                                </ComboBox>
                                <Border x:ConnectionId='90' x:Name="ProxySourceRow" Grid.Column="1" Visibility="Collapsed">
                                    <ComboBox x:ConnectionId='91' x:Name="ProxySource" Header="代理来源" Width="200" AutomationProperties.Name="代理来源" AutomationProperties.AutomationId="TaskProxySourceComboBox" SelectedIndex="0"                                        >
                                        <ComboBoxItem Content="默认代理" Tag="default" />
                                        <ComboBoxItem Content="限时福利" Tag="benefit" />
                                        <ComboBoxItem Content="自定义代理" Tag="custom" />
                                    </ComboBox>
                                </Border>
                            </Grid>

                            <Border x:ConnectionId='75' x:Name="FixedProxyRow" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:ConnectionId='87' x:Name="FixedProxyAddress" Header="固定代理地址" AutomationProperties.Name="固定代理地址" AutomationProperties.AutomationId="TaskFixedProxyAddressInput" PlaceholderText="http://127.0.0.1:8080" />
                                    <Button x:ConnectionId='88' Grid.Column="1" VerticalAlignment="Bottom"                          AutomationProperties.Name="测试固定代理连接" AutomationProperties.AutomationId="TaskTestFixedProxyButton"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh" /><TextBlock Text="测试连接" /></StackPanel></Button>
                                </Grid>
                            </Border>

                            <Border x:ConnectionId='76' x:Name="CustomProxyRow" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:ConnectionId='85' x:Name="CustomProxyApi" Header="代理 API 地址" AutomationProperties.Name="代理 API" AutomationProperties.AutomationId="TaskCustomProxyApiInput" PlaceholderText="https://..." />
                                    <Button x:ConnectionId='86' Grid.Column="1" VerticalAlignment="Bottom"                           AutomationProperties.Name="测试自定义代理连接" AutomationProperties.AutomationId="TaskTestCustomProxyButton"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh" /><TextBlock Text="测试连接" /></StackPanel></Button>
                                </Grid>
                            </Border>

                            <Border x:ConnectionId='77' x:Name="ProxyAreaRow" Visibility="Collapsed">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:ConnectionId='82' x:Name="ProxyProvince" Header="省份" HorizontalAlignment="Stretch" AutomationProperties.Name="代理省份" AutomationProperties.AutomationId="TaskProxyProvinceComboBox" PlaceholderText="不限制"                                           />
                                    <ComboBox x:ConnectionId='83' x:Name="ProxyCity" Grid.Column="1" Header="城市" HorizontalAlignment="Stretch" AutomationProperties.Name="代理城市" AutomationProperties.AutomationId="TaskProxyCityComboBox" PlaceholderText="不限制"                                       />
                                    <Button x:ConnectionId='84' x:Name="SyncProxyButton" Grid.Column="2" VerticalAlignment="Bottom"                     AutomationProperties.Name="同步代理额度" AutomationProperties.AutomationId="TaskSyncProxyButton"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Sync" /><TextBlock Text="同步额度" /></StackPanel></Button>
                                </Grid>
                            </Border>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                            <!-- 极简控制行 -->
                            <Grid MinHeight="36">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="随机 User-Agent 身份" />
                                <ToggleSwitch x:ConnectionId='81' x:Name="RandomUA" HorizontalAlignment="Right" AutomationProperties.Name="随机访问身份" AutomationProperties.AutomationId="TaskRandomUaToggle" OffContent="关" OnContent="开" />
                            </Grid>

                            <Grid MinHeight="36">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="量表信度拟真 (Cronbach's α)" />
                                <ToggleSwitch x:ConnectionId='80' x:Name="PsychometricsEnabled" HorizontalAlignment="Right" AutomationProperties.Name="启用心理学信度拟真" AutomationProperties.AutomationId="TaskPsychometricsToggle" OffContent="关" OnContent="开"                                  />
                            </Grid>

                            <Border x:ConnectionId='78' x:Name="PsychometricsRow" Visibility="Collapsed">
                                <NumberBox x:ConnectionId='79' x:Name="TargetAlpha" Header="目标信度 α (推荐 0.75 ~ 0.90)" Width="220" HorizontalAlignment="Left"
                                           AutomationProperties.Name="目标信度系数" AutomationProperties.AutomationId="TaskTargetAlphaNumberBox"
                                           Minimum="0.5" Maximum="0.99" SmallChange="0.01" LargeChange="0.05" SpinButtonPlacementMode="Compact" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 第 5 步：作答时长 / 间隔时长 / 作答时间 -->
                    <ScrollViewer x:ConnectionId='23' x:Name="TimingPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:ConnectionId='54'                                                         MaxWidth="720" Padding="32,24" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Refresh" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="时间与节奏" /></StackPanel>

                            <Grid ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:ConnectionId='67' x:Name="TimingSecondColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:ConnectionId='68' x:Name="TimingSecondRow" Height="0" /></Grid.RowDefinitions>
                                <StackPanel Spacing="12">
                                    <TextBlock FontWeight="SemiBold" Text="单份作答时长（秒）" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:ConnectionId='72' x:Name="AnswerDurationMin" Header="最短" AutomationProperties.AutomationId="TaskDurationMinBox" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:ConnectionId='73' x:Name="AnswerDurationMax" Grid.Column="1" Header="最长" AutomationProperties.AutomationId="TaskDurationMaxBox" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:ConnectionId='69' x:Name="SubmitIntervalPanel" Grid.Column="1" Spacing="12">
                                    <TextBlock FontWeight="SemiBold" Text="提交间隔冷却（秒）" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:ConnectionId='70' x:Name="SubmitIntervalMin" Header="最短" AutomationProperties.AutomationId="TaskIntervalMinBox" Minimum="0" Maximum="1800" SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:ConnectionId='71' x:Name="SubmitIntervalMax" Grid.Column="1" Header="最长" AutomationProperties.AutomationId="TaskIntervalMaxBox" Minimum="0" Maximum="1800" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                            <TextBlock FontWeight="SemiBold" Text="有效作答时间窗口" />
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:ConnectionId='60' x:Name="WindowSecondColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:ConnectionId='61' x:Name="WindowSecondRow" Height="0" /></Grid.RowDefinitions>
                                <StackPanel Spacing="8">
                                    <CalendarDatePicker x:ConnectionId='65' x:Name="WindowStartDate" Header="开始日期" AutomationProperties.AutomationId="TaskWindowStartDatePicker" HorizontalAlignment="Stretch" />
                                    <TimePicker x:ConnectionId='66' x:Name="WindowStartTime" Header="开始时间" AutomationProperties.AutomationId="TaskWindowStartTimePicker" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel x:ConnectionId='62' x:Name="WindowEndPanel" Grid.Column="1" Spacing="8">
                                    <CalendarDatePicker x:ConnectionId='63' x:Name="WindowEndDate" Header="结束日期" AutomationProperties.AutomationId="TaskWindowEndDatePicker" HorizontalAlignment="Stretch" />
                                    <TimePicker x:ConnectionId='64' x:Name="WindowEndTime" Header="结束时间" AutomationProperties.AutomationId="TaskWindowEndTimePicker" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                            <Grid MinHeight="36">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="连续失败时自动停止" />
                                <ToggleSwitch x:ConnectionId='59' x:Name="FailStop" HorizontalAlignment="Right" AutomationProperties.Name="连续失败时停止" AutomationProperties.AutomationId="TaskFailStopToggle" OffContent="关" OnContent="开" />
                            </Grid>

                            <Grid MinHeight="36">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="遇到验证码时自动暂停" />
                                <ToggleSwitch x:ConnectionId='58' x:Name="PauseCaptcha" HorizontalAlignment="Right" AutomationProperties.Name="遇到验证码时暂停" AutomationProperties.AutomationId="TaskPauseCaptchaToggle" OffContent="关" OnContent="开" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                            <Grid MinHeight="36">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="Excel 反填" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="按表格内容覆盖对应答案" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button x:ConnectionId='55' x:Name="ReverseFillButton"                             AutomationProperties.Name="选择 Excel 反填文件" AutomationProperties.AutomationId="TaskReverseFillPickButton"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="OpenFile" /><TextBlock x:ConnectionId='57' x:Name="ReverseFillButtonLabel" Text="选择 Excel" /></StackPanel></Button>
                                    <ToggleSwitch x:ConnectionId='56' x:Name="ReverseFillEnabled" AutomationProperties.Name="启用 Excel 反填" AutomationProperties.AutomationId="TaskReverseFillEnabledToggle" OffContent="关" OnContent="开" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 第 6 步：目标份数 / 并发数 / 开始作答 -->
                    <ScrollViewer x:ConnectionId='24' x:Name="LaunchPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:ConnectionId='39'                                                         MaxWidth="720" Padding="32,24" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Send" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="规模与启动" /></StackPanel>

                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:ConnectionId='50' x:Name="LaunchSecondColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:ConnectionId='51' x:Name="LaunchSecondRow" Height="0" /></Grid.RowDefinitions>
                                <NumberBox x:ConnectionId='52' x:Name="TargetCount" Header="目标提交份数" AutomationProperties.Name="目标份数" AutomationProperties.AutomationId="TaskTargetCountBox" Minimum="1" Maximum="999999" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:ConnectionId='53' x:Name="ThreadCount" Grid.Column="1" Header="并发线程数" AutomationProperties.Name="并发数" AutomationProperties.AutomationId="TaskThreadCountBox" Minimum="1" Maximum="128" SpinButtonPlacementMode="Compact" />
                            </Grid>

                            <TextBlock FontWeight="SemiBold" Text="任务配置摘要" Margin="0,4,0,0" />
                            <StackPanel Spacing="0">
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="问卷标题" />
                                    <TextBlock x:ConnectionId='49' x:Name="ReviewSurvey" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskReviewSurveyText" TextWrapping="Wrap" />
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="平台与题目" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:ConnectionId='47' x:Name="ReviewProvider" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskReviewProviderText" />
                                        <TextBlock x:ConnectionId='48' x:Name="ReviewQuestions" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskReviewQuestionsText" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="规模与并发" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:ConnectionId='45' x:Name="ReviewTarget" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskReviewTargetText" />
                                        <TextBlock x:ConnectionId='46' x:Name="ReviewThreads" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskReviewThreadsText" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="网络与信度" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                                        <TextBlock x:ConnectionId='43' x:Name="ReviewNetwork" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskReviewNetworkText" />
                                        <TextBlock x:ConnectionId='44' x:Name="ReviewReliability" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskReviewReliabilityText" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="作答时长" />
                                    <TextBlock x:ConnectionId='42' x:Name="ReviewDuration" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskReviewDurationText" />
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="问卷地址" />
                                    <TextBlock x:ConnectionId='41' x:Name="ReviewUrl" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="TaskReviewUrlText" />
                                </Grid>
                            </StackPanel>

                            <ListView x:ConnectionId='40' x:Name="CheckProblems" SelectionMode="None" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 运行态：任务运行与实时监控 -->
                    <ScrollViewer x:ConnectionId='25' x:Name="RunPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:ConnectionId='26'                                                      MaxWidth="800" Padding="32,24" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Send" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="任务运行" /></StackPanel>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:ConnectionId='37' x:Name="RunProgress" Minimum="0" Maximum="1" Value="0" Height="8" VerticalAlignment="Center" CornerRadius="4" AutomationProperties.AutomationId="TaskRunProgressBar" />
                                <TextBlock x:ConnectionId='38' x:Name="RunProgressText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskRunProgressText" Text="0 / 0" />
                            </Grid>

                            <Border x:ConnectionId='27' x:Name="RunResultCard" Visibility="Collapsed" Padding="16,12" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="成功份数" />
                                        <TextBlock x:ConnectionId='36' x:Name="RunResultSuccess" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskRunSuccessText" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="失败份数" />
                                        <TextBlock x:ConnectionId='35' x:Name="RunResultFail" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskRunFailText" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="提交合计" />
                                        <TextBlock x:ConnectionId='34' x:Name="RunResultTotal" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="TaskRunTotalText" Text="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:ConnectionId='30' x:Name="PauseButton" Content="暂停任务" IsEnabled="False" AutomationProperties.AutomationId="TaskPauseButton"                    />
                                <Button x:ConnectionId='31' x:Name="ResumeButton" Content="继续任务" IsEnabled="False" AutomationProperties.AutomationId="TaskResumeButton"                     />
                                <Button x:ConnectionId='32' x:Name="StopButton" Content="停止任务" IsEnabled="False" AutomationProperties.AutomationId="TaskStopButton"                   />
                                <Button x:ConnectionId='33' x:Name="ExportResultButton" Visibility="Collapsed" Content="导出作答结果" AutomationProperties.AutomationId="TaskExportResultButton"                        />
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="260" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="实时日志" />
                                    <Button x:ConnectionId='29' x:Name="ExportLogsButton" Visibility="Collapsed" HorizontalAlignment="Right" Content="导出日志" AutomationProperties.AutomationId="TaskExportLogsButton"                      />
                                </Grid>
                                <ListView x:ConnectionId='28' x:Name="RunLogs" Grid.Row="1" Margin="0,8,0,0"                                              AutomationProperties.AutomationId="TaskRunLogsList" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 底栏：返回、下一步 / 启动按钮 -->
                <Rectangle x:ConnectionId='12' x:Name="FooterDivider" Grid.Row="3" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid x:ConnectionId='13' x:Name="FooterBar" Grid.Row="4" Padding="32,0">
                    <TextBlock x:ConnectionId='14' x:Name="FooterStatus" VerticalAlignment="Center" AutomationProperties.AutomationId="TaskFooterStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                        <Button x:ConnectionId='15' x:Name="BackButton"                AutomationProperties.Name="返回上一步" AutomationProperties.AutomationId="TaskBackButton"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Back" /><TextBlock Text="返回上一步" /></StackPanel></Button>
                        <Button x:ConnectionId='16' x:Name="PrimaryButton" Style="{StaticResource AccentButtonStyle}"                   AutomationProperties.Name="继续" AutomationProperties.AutomationId="TaskPrimaryButton">
                            <Button.ContentTransitions>
                                <TransitionCollection>
                                    <ContentThemeTransition />
                                </TransitionCollection>
                            </Button.ContentTransitions>
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon x:ConnectionId='17' x:Name="PrimaryButtonIcon" Symbol="Forward" /><TextBlock x:ConnectionId='18' x:Name="PrimaryButtonLabel" Text="继续" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 浮动通知与状态展示 InfoBar -->
            <StackPanel x:ConnectionId='5' x:Name="StatusPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Spacing="8" IsHitTestVisible="True">
                <InfoBar x:ConnectionId='6' x:Name="SurveyStatus" IsOpen="False" IsClosable="False" MaxWidth="720" AutomationProperties.AutomationId="TaskSurveyStatus" />
                <InfoBar x:ConnectionId='7' x:Name="NetworkStatus" IsOpen="False" IsClosable="False" MaxWidth="720" Severity="Informational" Title="直连" Message="不使用代理访问问卷。" AutomationProperties.AutomationId="TaskNetworkStatus" />
                <InfoBar x:ConnectionId='8' x:Name="CheckStatus" IsOpen="False" IsClosable="False" MaxWidth="720" Severity="Informational" Title="尚未检查配置" Message="点击底部按钮检查整套配置并启动作答。" AutomationProperties.AutomationId="TaskCheckStatus" />
                <InfoBar x:ConnectionId='9' x:Name="RunStatus" IsOpen="False" IsClosable="False" MaxWidth="720" Severity="Informational" Title="尚未启动" Message="配置保存后可以启动任务。" AutomationProperties.AutomationId="TaskRunStatus" />
                <InfoBar x:ConnectionId='10' x:Name="RunExportStatus" IsOpen="False" IsClosable="False" MaxWidth="720" AutomationProperties.AutomationId="TaskRunExportStatus" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

