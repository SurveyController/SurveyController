<Page x:ConnectionId='1'
    x:Class="SurveyController.App.Views.MorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App.ViewModels">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:ConnectionId='2' x:Name="CompactDonationLayout" />
                <VisualState x:ConnectionId='3' x:Name="WideDonationLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource DesktopBreakpointWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DonationRightColumn.Width" Value="*" />
                        <Setter Target="DonationRightGroup.(Grid.Row)" Value="0" />
                        <Setter Target="DonationRightGroup.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer x:ConnectionId='4' x:Name="MoreScrollViewer" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:ConnectionId='5'                                                              Padding="24,24,24,32" HorizontalAlignment="Left" Spacing="16">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="更多" />

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="96" Height="96" VerticalAlignment="Top" Source="ms-appx:///Assets/appicon.png" Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="SurveyController" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="高效的自动化问卷填写工具" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="当前版本 v5.0.0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="16" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon VerticalAlignment="Top" Symbol="Important" />
                        <TextBlock Grid.Column="1" Text="本项目仅供学习交流使用，禁止用于恶意滥用行为。" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="更新" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="当前版本" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:ConnectionId='40' x:Name="VersionText" FontWeight="SemiBold" AutomationProperties.AutomationId="MoreVersionText" Text="v5.0.0" />
                                <TextBlock x:ConnectionId='41' x:Name="PublishDate" Style="{StaticResource CaptionTextBlockStyle}" Text="" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:ConnectionId='36' x:Name="UpdateStatus" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="MoreUpdateStatusText" Style="{StaticResource CaptionTextBlockStyle}" Text="点击检查新版本" TextWrapping="Wrap" />
                        <TextBlock x:ConnectionId='37' x:Name="ReleaseNotes" Visibility="Collapsed" AutomationProperties.AutomationId="MoreReleaseNotesText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:ConnectionId='38' x:Name="UpdateButton" AutomationProperties.AutomationId="MoreCheckUpdateButton" Content="检查更新"                       />
                            <Button x:ConnectionId='39' x:Name="DownloadButton" IsEnabled="False" AutomationProperties.AutomationId="MoreDownloadButton" Content="下载安装包"                        />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="相关链接" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:ConnectionId='33' AutomationProperties.AutomationId="MoreRepositoryButton" Content="GitHub 仓库"                          />
                            <Button x:ConnectionId='34' AutomationProperties.AutomationId="MoreTutorialButton" Content="官方文档"                        />
                            <Button x:ConnectionId='35' AutomationProperties.AutomationId="MoreLicenseButton" Content="查看许可证"                       />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="项目致谢" />
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="License：GPL-3.0 License" />
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="贡献者" />
                                <HyperlinkButton x:ConnectionId='27' HorizontalAlignment="Left" Content="@HUNGRY_M0"                            />
                                <HyperlinkButton x:ConnectionId='28' HorizontalAlignment="Left" Content="@shiahonb777"                            />
                                <HyperlinkButton x:ConnectionId='29' HorizontalAlignment="Left" Content="@BingBuLiang"                            />
                                <HyperlinkButton x:ConnectionId='30' HorizontalAlignment="Left" Content="@dAwn-Rebirth"                            />
                                <HyperlinkButton x:ConnectionId='31' HorizontalAlignment="Left" Content="@Moyuin-aka"                            />
                                <HyperlinkButton x:ConnectionId='32' HorizontalAlignment="Left" Content="@qintaiyang"                            />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="服务条款与隐私声明" />
                                <Button x:ConnectionId='26' AutomationProperties.AutomationId="MoreTermsButton" Content="查看详情"                     />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Text="更多入口" />
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="打开更多功能">
                    <StackPanel Padding="0,8,0,4" Spacing="8">
                        <Button x:ConnectionId='22' HorizontalContentAlignment="Left" AutomationProperties.AutomationId="MoreChangelogButton" Content="更新日志"                         />
                        <Button x:ConnectionId='23' HorizontalContentAlignment="Left" AutomationProperties.AutomationId="MoreTutorial2Button" Content="使用教程"                        />
                        <Button x:ConnectionId='24' HorizontalContentAlignment="Left" AutomationProperties.AutomationId="MoreIpUsageButton" Content="IP 使用记录"                       />
                        <Button x:ConnectionId='25' HorizontalContentAlignment="Left" AutomationProperties.AutomationId="MoreDonationButton" Content="捐助"                        />
                    </StackPanel>
                </Expander>

                <Expander x:ConnectionId='6' x:Name="DonationExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="支持作者">
                    <StackPanel Padding="0,12,0,4" Spacing="16">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="如果这个项目对你有帮助，欢迎请作者喝杯奶茶。" TextWrapping="Wrap" />
                        <Grid x:ConnectionId='17' x:Name="DonationLayout" ColumnSpacing="16" RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:ConnectionId='18' x:Name="DonationLeftColumn" Width="*" />
                                <ColumnDefinition x:ConnectionId='19' x:Name="DonationRightColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:ConnectionId='20' x:Name="DonationLeftGroup" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="微信赞赏" />
                                <Image Width="220" Height="220" HorizontalAlignment="Left" Source="ms-appx:///Assets/WeDonate.png" Stretch="Uniform" />
                            </StackPanel>
                            <StackPanel x:ConnectionId='21' x:Name="DonationRightGroup" Grid.Row="1" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="支付宝" />
                                <Image Width="220" Height="220" HorizontalAlignment="Left" Source="ms-appx:///Assets/AliDonate.jpg" Stretch="Uniform" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="感谢每一位支持者，你们的鼓励是持续更新的动力。" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander x:ConnectionId='7' x:Name="IPUsageExpander" AutomationProperties.AutomationId="MoreIpUsageExpander" Header="IP 使用记录">
                    <StackPanel Padding="0,12,0,4" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:ConnectionId='15' AutomationProperties.AutomationId="MoreIpUsageRefreshButton" Content="刷新记录"                       />
                            <TextBlock x:ConnectionId='16' x:Name="IPBalance" VerticalAlignment="Center" AutomationProperties.AutomationId="MoreIpBalanceText" Style="{StaticResource CaptionTextBlockStyle}" Text="IP 池剩余数量：未加载" />
                        </StackPanel>
                        <TextBlock x:ConnectionId='8' x:Name="IPUsageStatus" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="MoreIpUsageStatusText" Style="{StaticResource CaptionTextBlockStyle}" Text="" TextWrapping="Wrap" />
                        <ListView x:ConnectionId='9'                                                MaxHeight="360" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate                              >
                                    <Grid x:ConnectionId='11' ColumnSpacing="12" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:ConnectionId='12' VerticalAlignment="Center"                       />
                                        <ProgressBar x:ConnectionId='13' Grid.Column="1" VerticalAlignment="Center"                                                   />
                                        <TextBlock x:ConnectionId='14' Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"                           />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>

                <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}" Text="Copyright © 2026 HUNGRY_M0. All rights reserved." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

